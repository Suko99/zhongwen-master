      "grammar": [
        {
          "point": "Couleurs + 的 pour décrire",
          "explanation": "On utilise [couleur] + 的 pour décrire un vêtement. Exemple : 红色的 (rouge). Erreur typique : oublier 的.",
          "examples": [
            {
              "chinese": "这件蓝色的很好看。",
              "pinyin": "Zhè jiàn lánsè de hěn hǎokàn.",
              "translation": "Ce bleu est très joli."
            },
            {
              "chinese": "我喜欢白色的。",
              "pinyin": "Wǒ xǐhuān báisè de.",
              "translation": "J'aime le blanc."
            }
          ]
        },
        {
          "point": "Classificateurs 件, 条, 双",
          "explanation": "件 pour hauts, 条 pour bas, 双 pour paires. Erreur typique : utiliser 个 à la place.",
          "examples": [
            {
              "chinese": "这件多少钱？",
              "pinyin": "Zhè jiàn duōshǎo qián?",
              "translation": "Combien coûte ceci ?"
            },
            {
              "chinese": "我买了两条。",
              "pinyin": "Wǒ mǎile liǎng tiáo.",
              "translation": "J'ai acheté deux."
            },
            {
              "chinese": "这双多少钱？",
              "pinyin": "Zhè shuāng duōshǎo qián?",
              "translation": "Combien coûte cette paire ?"
            }
          ]
        },
        {
          "point": "Redoublement 试试",
          "explanation": "试试 exprime une action brève. Erreur typique : oublier le redoublement.",
          "examples": [
            {
              "chinese": "我可以试试这件吗？",
              "pinyin": "Wǒ kěyǐ shìshi zhè jiàn ma?",
              "translation": "Puis-je essayer ceci ?"
            },
            {
              "chinese": "你试试这双吧。",
              "pinyin": "Nǐ shìshi zhè shuāng ba.",
              "translation": "Essaie cette paire."
            }
          ]
        }
      ],
