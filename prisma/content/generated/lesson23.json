  "content": {
    "mission": {
      "scenario": "安娜和李华去买衣。安娜想买一条裙和一件衣。李华帮她选颜色。",
      "goals": [
        "说你想买什么颜色的衣",
        "问可以试试吗",
        "用件、条、双说衣"
      ]
    },
    "discovery": {
      "instructions": "看下面的对话。找出颜色、衣和件、条、双的用法。",
      "dialogue": [
        {
          "speaker": "安娜",
          "chinese": "李华，这件红色的怎么样？",
          "pinyin": "Lǐ Huá, zhè jiàn hóngsè de zěnmeyàng?",
          "translation": "Li Hua, que penses-tu de ce rouge ?"
        },
        {
          "speaker": "李华",
          "chinese": "很好看！你喜欢什么颜的？",
          "pinyin": "Hěn hǎokàn! Nǐ xǐhuān shénme yánsè de?",
          "translation": "Très joli ! Quelle couleur aimes-tu ?"
        },
        {
          "speaker": "安娜",
          "chinese": "我喜欢蓝色的。这条蓝色的怎么样？",
          "pinyin": "Wǒ xǐhuān lánsè de. Zhè tiáo lánsè de zěnmeyàng?",
          "translation": "J'aime le bleu. Que penses-tu de ce bleu ?"
        },
        {
          "speaker": "李华",
          "chinese": "很好看！你要试试吗？",
          "pinyin": "Hěn hǎokàn! Nǐ yào shìshi ma?",
          "translation": "Très joli ! Veux-tu essayer ?"
        },
        {
          "speaker": "安娜",
          "chinese": "好的，我可以试试这件吗？",
          "pinyin": "Hǎo de, wǒ kěyǐ shìshi zhè jiàn ma?",
          "translation": "D'accord, puis-je essayer ceci ?"
        },
        {
          "speaker": "李华",
          "chinese": "可以，在那儿。",
          "pinyin": "Kěyǐ, zài nàr.",
          "translation": "Oui, là-bas."
        },
        {
          "speaker": "安娜",
          "chinese": "这件有点儿小，有大的吗？",
          "pinyin": "Zhè jiàn yǒudiǎnr xiǎo, yǒu dà de ma?",
          "translation": "Ceci est un peu petit, en avez-vous un plus grand ?"
        },
        {
          "speaker": "李华",
          "chinese": "有，我给你拿一件白色的。",
          "pinyin": "Yǒu, wǒ gěi nǐ ná yī jiàn báisè de.",
          "translation": "Oui, je t'apporte un blanc."
        }
      ]
    },
